        "concurrency": "debounce 60s; sync-guard.lock (stale 5min)",
        "endpoint": "GET /api/health/pipeline",
        "guard": "lag >60 ticks trigger threshold",
        "target": "spawns survey:sync --latest-only (external CLI)"
      }
    ]
  }
}
