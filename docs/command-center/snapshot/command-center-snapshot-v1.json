    "credential_hygiene": [
      "registry stores SHA-256 key hashes; plaintext simkey returned exactly once",
      "production agents register only api_key_tail (never the full key)",
      "shop cookie accepted via X-Shop-Cookie header, never persisted server-side",
      "redeem log stores first 6 chars of the code only",
      "any list/query response excludes plaintext keys"
